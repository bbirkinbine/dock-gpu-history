#-- Template for the Homebrew cask. scripts/release.sh substitutes the version
#-- and sha256 placeholders and writes the result to build/release/; copy that
#-- file into the tap repo (bbirkinbine/homebrew-tap) as Casks/gpu-dock-history.rb.
#--
#-- Lines starting with "#--" are template notes and are stripped from the
#-- generated cask, so nothing here leaks into the tap. Keep ordinary "#"
#-- comments only for text that belongs in the shipped cask.
#--
#-- This file lives in packaging/ rather than a Casks/ directory because this
#-- repo is the app, not the tap — a Casks/ folder here would make Homebrew
#-- treat it as one. See docs/HOMEBREW_DISTRIBUTION.md.
# Generated by scripts/release.sh in bbirkinbine/dock-gpu-history from
# packaging/gpu-dock-history.rb.in. Do not hand-edit: bump by re-running the
# release script and copying its output here.
cask "gpu-dock-history" do
  version "@@VERSION@@"
  sha256 "@@SHA256@@"

  url "https://github.com/bbirkinbine/dock-gpu-history/releases/download/v#{version}/GPU-Dock-History-#{version}.zip"
  name "GPU Dock History"
  desc "Live GPU utilization history in the Dock icon"
  homepage "https://github.com/bbirkinbine/dock-gpu-history"

  livecheck do
    url :url
    strategy :github_latest
  end

  #-- Order matters: `brew style` (Cask/StanzaOrder) wants arch before macos.
  #-- A bare symbol already means ">= that version" — the cask DSL parses
  #-- `depends_on macos:` with a ">=" comparator by default — and the explicit
  #-- ">= :ventura" string form fails `brew style` (Homebrew/OSDependsOn).
  depends_on arch: :arm64           # Apple Silicon only
  depends_on macos: :ventura        # macOS 13+ or newer

  app "GPU Dock History.app"
  #-- Re-enable the caveats block below once the Mac App Store listing is live.
  #-- It is stripped today because the app is not on the store yet, and shipping
  #-- it would point users at a listing that does not exist. The warning cannot
  #-- be expressed as `conflicts_with`, which only arbitrates cask against cask
  #-- and cannot see a Mac App Store install.
  #-- caveats <<~EOS
  #--   GPU Dock History is also on the Mac App Store. Installing both leaves two
  #--   copies claiming the same bundle identifier; keep only one.
  #-- EOS

  zap trash: [
    "~/Library/Containers/com.bbirkinbine.gpu-dock-history",
    "~/Library/Preferences/com.bbirkinbine.gpu-dock-history.plist",
  ]
end
